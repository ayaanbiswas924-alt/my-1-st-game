[sub_resource type="GDScript" id="GDScript_eqrsh"]
script/source = "extends Node2D
const ice = preload(\"res://ice.webp\")

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	$Fire.change_image(ice)
	$Fire.scale(10.0)
	$Fire2.change_image(ice)
	$Fire2.scale(10.0)
	$Fire3.change_image(ice)
	$Fire3.scale(10.0)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

